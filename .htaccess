Options -Indexes -MultiViews


# URL propres : /inscription, /conditions et /admin (les .php redirigent vers la version courte)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{THE_REQUEST} \s/+(.*/)?(inscription|admin|conditions)\.php[\s?] [NC]
  RewriteRule ^(inscription|admin|conditions)\.php$ /%1%2 [R=301,L]
  RewriteCond %{REQUEST_URI} ^(.*/)(inscription|admin|conditions)/$
  RewriteRule ^ %1%2 [R=301,L]
  RewriteRule ^(inscription|admin|conditions)$ $1.php [L,QSA]
</IfModule>
AddType image/webp .webp
# Cache : les pages PHP ne sont jamais mises en cache (no-store côté PHP).
# CSS et JS sont appelés avec ?v=<date de modification> (skylon_asset) : nouvelle URL à chaque modif.
# Images et vidéos : le navigateur revérifie à chaque visite (réponse 304 légère si rien n'a changé),
# pour qu'un fichier remplacé sous le même nom s'affiche tout de suite chez le client.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType text/javascript "access plus 30 days"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpe?g|png|svg|gif|mp4|webm|mov)$">
    Header set Cache-Control "no-cache"
    Header unset Expires
  </FilesMatch>
</IfModule>
